# BathCraft — environment template. Placeholders only; never commit real values.
# Copy to `.env.local` (git-ignored) and fill in.

# ─── Auth.js session encryption ──────────────────────────────────────────────
# Signs and encrypts the session cookie. Generate with:  npx auth secret
# Rotating this signs everyone out. It must differ between dev and production.
AUTH_SECRET=your_auth_secret

# ─── Google OAuth 2.0 / OpenID Connect ───────────────────────────────────────
# From Google Cloud Console → Google Auth Platform → Clients → Web application.
# These exact names are what Auth.js v5 auto-detects for the Google provider.
# AUTH_GOOGLE_SECRET is server-only — it must never be prefixed NEXT_PUBLIC_.
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ─── Deployment URL ──────────────────────────────────────────────────────────
# Only needed where Auth.js cannot infer the origin. Vercel sets this itself;
# leave it unset locally (http://localhost:3000 is the default).
# AUTH_URL=https://your-production-domain.example/api/auth

# ─── Local user store ────────────────────────────────────────────────────────
# Development only. See the warning at the top of lib/db/store.ts: this JSON
# file must be replaced by a real database before production.
# BATHCRAFT_DATA_FILE=./.data/bathcraft.json
